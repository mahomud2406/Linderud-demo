{%- if site.demo %}
<aside class="demo-ribbon" aria-label="Om denne nettsiden">
  <div class="container">Forslag til ny nettside for {{ site.borettslag }}. Dagens side: <a href="{{ site.gammelSide }}">linderudbo.no</a></div>
</aside>
{%- endif %}
<header class="appbar">
  <div class="container appbar-inner">
    <a class="wordmark" href="/">{{ site.borettslag }}</a>

    <nav class="topnav" aria-label="Hovedmeny">
      <ul>
        {%- for item in meny %}
        {%- set aktiv = (item.url == "/" and page.url == "/") or (item.url != "/" and page.url.startsWith(item.url)) or (fane == item.tittel) %}
        <li><a href="{{ item.url }}"{% if aktiv %} aria-current="{{ 'page' if page.url == item.url else 'true' }}"{% endif %}>{{ item.tittel }}</a></li>
        {%- endfor %}
      </ul>
    </nav>

    <div class="appbar-actions">
      <a class="appbar-btn" href="/sok/" aria-label="Søk">
        <svg class="icon" aria-hidden="true"><use href="#i-sok"/></svg>
      </a>
      <a class="appbar-btn appbar-bell" href="/oppslag/" aria-label="Oppslag">
        <svg class="icon" aria-hidden="true"><use href="#i-bjelle"/></svg>
        {%- if collections.nyheter | length %}<span class="appbar-dot" aria-hidden="true"></span>{% endif %}
      </a>
    </div>
  </div>
</header>
