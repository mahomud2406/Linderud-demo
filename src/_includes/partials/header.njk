{%- set hovedmeny = collections.all | eleventyNavigation -%}
<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/" aria-label="{{ site.name }} – til forsiden">
      <svg class="brand-mark" viewBox="0 0 40 40" aria-hidden="true">
        <rect width="40" height="40" rx="10" fill="currentColor"/>
        <path d="M9 30V17l6-4 6 4v13M21 30V12l5-3 5 3v18M7 30h26" fill="none" stroke="#fff" stroke-width="2.4" stroke-linejoin="round" stroke-linecap="round"/>
      </svg>
      <span class="brand-text">
        <span class="brand-name">{{ site.name }}</span>
        <span class="brand-tagline">{{ site.borettslag }}</span>
      </span>
    </a>

    <div class="header-actions">
      <a class="icon-button" href="/sok/" aria-label="Søk på siden">
        <svg class="icon" aria-hidden="true"><use href="#i-sok"/></svg>
      </a>
      <button class="icon-button menu-toggle" type="button" aria-expanded="false" aria-controls="hovedmeny">
        <svg class="icon icon-open" aria-hidden="true"><use href="#i-meny"/></svg>
        <svg class="icon icon-close" aria-hidden="true"><use href="#i-lukk"/></svg>
        <span class="menu-toggle-label">Meny</span>
      </button>
    </div>

    <nav id="hovedmeny" class="main-nav" aria-label="Hovedmeny">
      <ul>
        {%- for entry in hovedmeny %}
        {%- set aktiv = page.url == entry.url or (entry.url != "/" and page.url.startsWith(entry.url)) %}
        <li><a href="{{ entry.url }}"{% if aktiv %} aria-current="{{ 'page' if page.url == entry.url else 'true' }}"{% endif %}>{{ entry.title }}</a></li>
        {%- endfor %}
      </ul>
    </nav>
  </div>
</header>
