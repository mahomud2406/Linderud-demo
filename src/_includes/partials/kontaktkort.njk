<ul class="contact-grid" role="list">
  {%- for k in kontakter.personer %}
  <li class="card contact-card">
    <h3>
      <span class="card-icon"><svg class="icon" aria-hidden="true"><use href="#{{ k.ikon }}"/></svg></span>
      {{ k.rolle }}
    </h3>
    {%- if k.navn %}<p class="contact-name">{{ k.navn }}</p>{% endif %}
    {%- if k.beskrivelse %}<p class="contact-desc">{{ k.beskrivelse }}</p>{% endif %}
    {%- if k.telefon or k.epost %}
    <div class="contact-actions">
      {%- if k.telefon %}
      <a class="button" href="tel:{{ k.telefon | telLenke }}">
        <svg class="icon" aria-hidden="true"><use href="#i-telefon"/></svg>
        {{ k.telefon }}
      </a>
      {%- endif %}
      {%- if k.epost %}
      <a class="button button-secondary" href="mailto:{{ k.epost }}">
        <svg class="icon" aria-hidden="true"><use href="#i-epost"/></svg>
        {{ k.epost }}
      </a>
      {%- endif %}
    </div>
    {%- else %}
    <p class="contact-missing">Kontaktinformasjon overføres fra dagens nettside.</p>
    {%- endif %}
  </li>
  {%- endfor %}
</ul>
