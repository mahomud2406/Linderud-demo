<footer class="site-footer">
  <div class="container footer-grid">
    <section aria-labelledby="footer-om">
      <h2 id="footer-om" class="footer-heading">{{ site.borettslag }}</h2>
      <p>{{ site.adresse }}</p>
      <p>Org.nr. {{ site.orgnr }}</p>
      <p><a href="/temaer/borettslaget/">Om borettslaget</a></p>
    </section>

    <section aria-labelledby="footer-kontakt">
      <h2 id="footer-kontakt" class="footer-heading">Kontakt</h2>
      <ul class="footer-links">
        {%- for k in kontakter.personer %}
        <li>
          <span class="footer-role">{{ k.rolle }}</span>
          {%- if k.telefon %}<a href="tel:{{ k.telefon | telLenke }}">{{ k.telefon }}</a>{% if k.epost %} · {% endif %}{% endif %}
          {%- if k.epost %}<a href="mailto:{{ k.epost }}">{{ k.epost }}</a>{% endif %}
        </li>
        {%- endfor %}
      </ul>
    </section>

    <section aria-labelledby="footer-temaer">
      <h2 id="footer-temaer" class="footer-heading">Populære temaer</h2>
      <ul class="footer-links">
        {%- for t in temaer | head(7) %}
        <li><a href="{{ t.url }}">{{ t.tittel }}</a></li>
        {%- endfor %}
      </ul>
    </section>
  </div>
  <div class="container footer-bottom">
    <p>© {{ build.year }} {{ site.borettslag }}</p>
    <p><a href="/om-nettsiden/">Om nettsiden</a></p>
  </div>
</footer>
