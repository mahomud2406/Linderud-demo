---
layout: layouts/base.njk
---
{%- set tilbakeLenke = tilbake or { tekst: "Forside", url: "/" } -%}
{%- set visTemaer = "tema" in (tags or []) -%}

<div class="subpage-top">
  <div class="container">
    <a class="back-link" href="{{ tilbakeLenke.url }}">
      <svg class="icon" aria-hidden="true"><use href="#i-tilbake"/></svg>
      {{ tilbakeLenke.tekst }}
    </a>
  </div>
</div>

<div class="container page-layout{% if visTemaer %} has-aside{% endif %}">
  <article class="page-main"{% if not eleventyExcludeFromCollections %} data-pagefind-body{% endif %}>
    <header class="page-header">
      <h1>{{ title }}</h1>
      {%- if ingress %}
      <p class="lead">{{ ingress }}</p>
      {%- endif %}
    </header>

    <div class="{{ 'page-content' if utenArk else 'sheet prose' }}">
      {{ content | safe }}
    </div>

    {%- if kilde %}
    <p class="page-meta" data-pagefind-ignore>
      Kilde: <a href="{{ kilde }}">{{ kilde | replace("http://", "") }}</a>{% if oppdatert %} · sist oppdatert <time datetime="{{ oppdatert | isoDato }}">{{ oppdatert | norskDato }}</time>{% endif %}
    </p>
    {%- endif %}
  </article>

  {%- if visTemaer %}
  <aside class="page-aside" aria-label="Andre temaer">
    <nav class="sheet side-list">
      <p class="side-list-title">Andre temaer</p>
      <ul>
        {%- for t in collections.temasider %}
        <li>
          <a href="{{ t.url }}"{% if page.url == t.url %} aria-current="page"{% endif %}>{{ t.data.title }}</a>
        </li>
        {%- endfor %}
      </ul>
    </nav>
  </aside>
  {%- endif %}
</div>
