<!doctype html>
<html lang="{{ site.lang }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title and page.url != "/" %}{{ title }} – {% endif %}{{ site.name }}</title>
  <meta name="description" content="{{ description or site.description }}">
  <meta name="theme-color" content="#1f5f4a" media="(prefers-color-scheme: light)">
  <meta name="theme-color" content="#101614" media="(prefers-color-scheme: dark)">
  <meta property="og:type" content="website">
  <meta property="og:locale" content="{{ site.locale }}">
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:title" content="{{ title or site.name }}">
  <meta property="og:description" content="{{ description or site.description }}">
  <script>document.documentElement.classList.add("js")</script>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/assets/css/main.css">
  <script src="/assets/js/main.js" defer></script>
  {% block head %}{% endblock %}
</head>
<body class="{{ bodyClass }}">
  {% include "partials/icons.njk" %}
  <a class="skip-link" href="#innhold">Hopp til innholdet</a>

  {% if site.demo %}
  <div class="demo-banner" role="note">
    <div class="container">
      <strong>Forslag til ny nettside.</strong>
      Dagens side finner du på <a href="{{ site.gammelSide }}">{{ site.gammelSide | replace("http://", "") }}</a>.
    </div>
  </div>
  {% endif %}

  {% include "partials/header.njk" %}

  <main id="innhold" tabindex="-1">
    {{ content | safe }}
  </main>

  {% include "partials/footer.njk" %}
</body>
</html>
