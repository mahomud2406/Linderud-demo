<!doctype html>
<html lang="{{ site.lang }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>{% if title and page.url != "/" %}{{ title }} – {% endif %}{{ site.borettslag }}</title>
  <meta name="description" content="{{ ingress or description or site.description }}">
  <meta name="theme-color" content="#ffffff">
  <meta name="color-scheme" content="light">
  <meta property="og:type" content="website">
  <meta property="og:locale" content="{{ site.locale }}">
  <meta property="og:site_name" content="{{ site.tittel }}">
  <meta property="og:title" content="{{ title or site.borettslag }}">
  <meta property="og:description" content="{{ ingress or description or site.description }}">
  <script>document.documentElement.classList.add("js")</script>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="preload" href="/assets/fonts/poppins-400.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/assets/css/main.css">
  <script src="/assets/js/main.js" defer></script>
  {% block head %}{% endblock %}
</head>
<body class="{{ bodyClass }}">
  {% include "partials/icons.njk" %}
  <a class="skip-link" href="#innhold">Hopp til innholdet</a>

  {% include "partials/header.njk" %}

  <main id="innhold" tabindex="-1">
    {{ content | safe }}
  </main>

  {% include "partials/footer.njk" %}
  {% include "partials/tabbar.njk" %}
</body>
</html>
