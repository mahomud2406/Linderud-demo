---
layout: layouts/page.njk
utenArk: true
title: Temaer
ingress: Finn informasjon om det du lurer på.
permalink: /temaer/
---
<section aria-label="Alle temaer">
<ul class="topic-cards" role="list">
  {%- for t in collections.temasider %}
  <li>
    <a class="topic-card" href="{{ t.url }}">
      <span>
        <strong>{{ t.data.title }}</strong>
        {%- if t.data.kort %}<small>{{ t.data.kort }}</small>{% endif %}
      </span>
      <svg class="icon" aria-hidden="true"><use href="#i-chevron"/></svg>
    </a>
  </li>
  {%- endfor %}
</ul>
</section>
